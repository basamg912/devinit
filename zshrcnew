# ============================================================================
#  ~/.zshrc
# ============================================================================
#  구조
#    1. p10k instant prompt   (반드시 최상단)
#    2. Homebrew prefix 결정
#    3. Oh My Zsh
#    4. 히스토리 / 셸 옵션
#    5. PATH & 환경변수
#    6. conda (지연 로딩)
#    7. 외부 도구 (fzf, zoxide, gcloud)
#    8. alias
#    9. 비밀값
#   10. zsh 플러그인 (반드시 최하단)
# ============================================================================


# ----------------------------------------------------------------------------
# 1. Powerlevel10k instant prompt
# ----------------------------------------------------------------------------
# .zshrc 로딩이 끝나기 전에 캐시된 프롬프트를 먼저 그린다.
# 콘솔 입력이 필요한 코드(비밀번호 프롬프트 등)는 반드시 이 블록 *위*에 둘 것.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi


# ----------------------------------------------------------------------------
# 2. Homebrew prefix
# ----------------------------------------------------------------------------
# `$(brew --prefix)`는 셸을 열 때마다 서브프로세스를 띄운다(50~150ms).
# 디렉토리 존재 여부로 판단하면 프로세스 생성 없이 끝난다.
if [[ -d /opt/homebrew ]]; then
  BREW_PREFIX=/opt/homebrew          # Apple Silicon
else
  BREW_PREFIX=/usr/local             # Intel
fi


# ----------------------------------------------------------------------------
# 3. Oh My Zsh
# ----------------------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"

# 자동 업데이트: 때가 되면 물어보기
zstyle ':omz:update' mode reminder

# 대용량 저장소에서 git 상태 확인이 느릴 때 주석 해제
# DISABLE_UNTRACKED_FILES_DIRTY="true"

# zsh-autosuggestions / zsh-syntax-highlighting은 여기 넣지 않는다.
# 로딩 순서가 중요해서 파일 맨 아래에서 직접 source 한다(섹션 10).
plugins=(
  git
  macos             # ofd, cdf, quick-look 등 Finder 연동
  docker
  python            # pyfind, pyclean 등
  extract           # 확장자 무관하게 `x file.tar.gz`
)

source "$ZSH/oh-my-zsh.sh"


# ----------------------------------------------------------------------------
# 4. 히스토리 / 셸 옵션
# ----------------------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

setopt EXTENDED_HISTORY        # 타임스탬프 기록
setopt HIST_EXPIRE_DUPS_FIRST  # 정리할 때 중복부터 버림
setopt HIST_IGNORE_ALL_DUPS    # 같은 명령은 하나만 남김
setopt HIST_IGNORE_SPACE       # 공백으로 시작하면 기록 안 함(비밀값 입력용)
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY             # `!!` 확장 시 바로 실행하지 않고 보여줌
setopt SHARE_HISTORY           # 탭 간 히스토리 공유
setopt INC_APPEND_HISTORY

setopt AUTO_CD                 # `Downloads` 만 쳐도 이동
setopt AUTO_PUSHD              # cd 이력을 스택에 쌓음 (`cd -2`)
setopt PUSHD_IGNORE_DUPS
setopt INTERACTIVE_COMMENTS    # 대화형 셸에서도 # 주석 허용


# ----------------------------------------------------------------------------
# 5. PATH & 환경변수
# ----------------------------------------------------------------------------
export LANG=en_US.UTF-8

export EDITOR="zed --wait"     # export 없으면 git commit 등이 못 읽는다
export VISUAL="$EDITOR"

export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"   # Antigravity


# ----------------------------------------------------------------------------
# 6. conda (지연 로딩)
# ----------------------------------------------------------------------------
# 원래 `conda init` 블록은 셸 시작마다 200~400ms를 쓴다.
# 아래는 conda/python/pip를 처음 호출하는 순간에만 초기화한다.
#
# ※ 터미널을 열자마자 base 환경이 활성화돼 있어야 한다면
#   이 블록을 지우고 원래 conda init 블록을 그대로 쓰면 된다.
__conda_lazy_init() {
  unset -f conda 2>/dev/null
  local __conda_setup
  __conda_setup="$('/opt/anaconda3/bin/conda' 'shell.zsh' 'hook' 2>/dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__conda_setup"
  elif [ -f "/opt/anaconda3/etc/profile.d/conda.sh" ]; then
    . "/opt/anaconda3/etc/profile.d/conda.sh"
  else
    export PATH="/opt/anaconda3/bin:$PATH"
  fi
}

conda() { __conda_lazy_init; conda "$@"; }


# ----------------------------------------------------------------------------
# 7. 외부 도구
# ----------------------------------------------------------------------------

# fzf — Ctrl-R 히스토리 검색, Ctrl-T 파일 검색, Alt-C 디렉토리 이동
# 설치: brew install fzf
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
  export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border"
  # fd가 있으면 .gitignore를 존중하는 더 빠른 검색
  if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  fi
fi

# zoxide — cd 대체. 자주 간 경로를 학습해 `cd isaac` 한 번에 이동
# 설치: brew install zoxide
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh --cmd cd)"
fi

# Google Cloud SDK
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then
  . "$HOME/google-cloud-sdk/path.zsh.inc"
fi
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then
  . "$HOME/google-cloud-sdk/completion.zsh.inc"
fi


# ----------------------------------------------------------------------------
# 8. alias
# ----------------------------------------------------------------------------
# 설치돼 있을 때만 덮어쓰도록 가드 — 없는 머신에서도 이 파일이 그대로 돈다
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -l --icons --git --group-directories-first'
  alias la='eza -la --icons --git --group-directories-first'
  alias lt='eza --tree --level=2 --icons'
else
  alias ll='ls -lh'
  alias la='ls -lah'
fi

if command -v bat >/dev/null 2>&1; then
  alias cat='bat --paging=never'
  export BAT_THEME="GitHub"      # iTerm2 / Zed 색 체계와 맞춤
fi

alias zshconfig="$EDITOR ~/.zshrc"
alias p10kconfig="$EDITOR ~/.p10k.zsh"
alias reload='exec zsh'

alias gs='git status -sb'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate -20'

# 셸 시작 시간 측정
alias zbench='for i in $(seq 1 5); do /usr/bin/time zsh -i -c exit; done'


# ----------------------------------------------------------------------------
# 9. 비밀값
# ----------------------------------------------------------------------------
# API 키/토큰은 이 파일에 직접 쓰지 않는다.
# ~/.zshenv.secrets 를 만들고 chmod 600, dotfiles 저장소에서는 gitignore.
[[ -f "$HOME/.zshenv.secrets" ]] && source "$HOME/.zshenv.secrets"


# ----------------------------------------------------------------------------
# 10. zsh 플러그인 — 반드시 파일 최하단
# ----------------------------------------------------------------------------
# 순서가 중요하다:
#   autosuggestions → syntax-highlighting → history-substring-search
# syntax-highlighting은 다른 ZLE 위젯이 전부 정의된 뒤에 와야 한다.
#
# 설치:
#   brew install zsh-autosuggestions zsh-syntax-highlighting zsh-history-substring-search

[[ -f "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && \
  source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

[[ -f "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
  source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

if [[ -f "$BREW_PREFIX/share/zsh-history-substring-search/zsh-history-substring-search.zsh" ]]; then
  source "$BREW_PREFIX/share/zsh-history-substring-search/zsh-history-substring-search.zsh"
  bindkey '^[[A' history-substring-search-up      # ↑
  bindkey '^[[B' history-substring-search-down    # ↓
fi


# ----------------------------------------------------------------------------
# Powerlevel10k 설정 — `p10k configure` 또는 ~/.p10k.zsh 직접 편집
# ----------------------------------------------------------------------------
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
